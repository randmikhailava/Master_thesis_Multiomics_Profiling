# List of cell types
cell_types <- c(
  
  "Endothelial_cells", "tumor", "Fibroblasts", "Bcells", "Tcells_CD4", "Tcells_CD8", "Tcells_other","Fibroblasts_Mesothelial", "Macrophages_Monocytes", "Mast_cells", "NKcells", "DCs"
)

# Output directory
out_dir <- "/Users/nikamikhailava/Desktop/Lab_stuff/batch_merged_new/"

# Loop through each cell type and save
for (ct in cell_types) {
  
  # Get expression matrix
  expr_mat <- scRNA_obj_all[[ct]]
  
  # Clean file name (no spaces)
  file_name <- gsub(" ", "_", ct)
  
  # Write CSV
  write.csv(
    expr_mat,
    paste0(out_dir, file_name, "_gene_expression_data_new_batch_merged_1903.csv"),
    row.names = TRUE
  )
  
  cat("Saved:", ct, "\n")
}

